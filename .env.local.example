# =============================================================
# Supabase — SERVER-ONLY (tanpa prefix NEXT_PUBLIC_). Semua akses
# dari browser lewat route API; anon key tetap dilindungi RLS.
# Di Vercel set keduanya sebagai tipe variabel "Secret".
# =============================================================
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# URL publik situs (server-only — redirect undangan & tautan reset Auth).
# WAJIB URL absolut (https://...). Nilai kosong membuat Supabase menolak
# redirect; kode punya fallback ke origin request / domain kanonik.
SITE_URL=https://www.smpmuh4tanggul.sch.id

# =============================================================
# Google Gemini (refrase konten panel admin) — server-side only
# =============================================================
GEMINI_API_KEY=
# Opsional; default gemini-3.8-flash dengan fallback otomatis ke
# gemini-3.7-flash lalu gemini-3.5-flash bila model bermasalah/padat.
# GEMINI_MODEL=gemini-3.8-flash

# =============================================================
# Supabase service role — HANYA server. Untuk mengundang/membuat
# pengguna admin (melewati RLS). JANGAN pernah diberi prefix NEXT_PUBLIC_.
# =============================================================
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================
# Video hero (opsional — Supabase egress); server-only, dikirim
# sebagai props ke HeroCarousel.
# =============================================================
# Default: video MP4 di Supabase Storage (52 MB).
# Setelah video di-upload ke YouTube (@MBSTANGGUL), isi ID video-nya
# (bagian setelah "v=" di URL) supaya hero memakai embed YouTube:
#   HERO_VIDEO_YT=dQw4w9WgXcQ
# HERO_VIDEO_YT=
# Hero video override URL (mis. setelah dipindah ke /public/videos/):
# HERO_VIDEO_URL=/videos/Profile.mp4

# =============================================================
# Storage Driver — Cloudflare R2 (dipakai produksi) atau Supabase Storage (warisan).
#   STORAGE_DRIVER=r2        → Cloudflare R2 (egress $0, S3-compatible)
#   STORAGE_DRIVER=supabase  → warisan; tidak lagi dipakai, hanya rollback darurat
# =============================================================
# STORAGE_DRIVER=r2

# Kredensial R2 (WAJIB lengkap saat STORAGE_DRIVER=r2):
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_PUBLIC_BASE_URL=https://cdn.smpmuh4tanggul.sch.id
# Nama bucket R2 (opsional; default "school-assets"):
# R2_BUCKET=school-assets
