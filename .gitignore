# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/screenshots/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# opencode: konfigurasi izin lokal (jangan di-commit)
opencode.json

# backup config lokal (jangan di-commit)
*.bak-*

# codegraph: indeks lokal (jangan di-commit)
.codegraph/

# opencode plugin credentials — token Telegram, jangan sampai ikut ter-commit
.opencode/**/secrets.json

# vercel
.vercel

# typescript
*.tsbuildinfo

# backup database supabase (berisi PII pendaftar + hash password) — jangan di-commit
/supabase_backup/
next-env.d.ts
nul
NUL